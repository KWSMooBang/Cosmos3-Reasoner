# Copy to .env (gitignored). scripts/run_suite.py loads it without overriding variables already
# exported in the shell. run_all-style ${VAR} placeholders in configs/models/*.json are filled
# from these at launch.

# --- endpoint under test (native vLLM from serving/, or any OpenAI-compatible server) ---
# Full chat-completions URL. Also used for the Qwen3-VL baselines (serve them on this URL instead).
COSMOS_API_BASE=http://localhost:8080/v1/chat/completions
# Served model id. The client also auto-detects it from GET /v1/models, so a placeholder works.
COSMOS_MODEL=nvidia/Cosmos3-Nano
COSMOS_API_KEY=EMPTY
# Recorded into execution evidence only (if enabled); keep in sync with PROTOCOL.md.
COSMOS_MODEL_REVISION=45666784803b3a7ad577e0def405f9afcc3bddb2

# --- datasets (big disk). Must exist: VLMEvalKit silently falls back to ~/LMUData otherwise ---
LMUData=/data0/Cosmos3-Reasoner/LMUData
# HF-hosted raw videos (VSI-Bench etc.) go to the HF cache:
# HF_HOME=/cache/huggingface

# --- LLM judge (only physics/SeePhys needs one; pinned model in PROTOCOL.md §6) ---
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1/chat/completions
