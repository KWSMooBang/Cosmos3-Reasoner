{
  "_note": "Thinking on (official prompt), official thinking sampling. sampling from NVIDIA/cosmos cookbooks/cosmos3/reasoner/reasoner_prompt_guide.md @1fe7e3be (also cosmos-framework prompt-guide.md).",
  "_hf_model": "nvidia/Cosmos3-Nano",
  "model_family": "cr",
  "model_key": "cosmos3_nano_think_official",
  "class": "CosmosReason3Think",
  "defaults": {
